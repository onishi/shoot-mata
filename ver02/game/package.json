{
  "name": "shoot-mata-v02-game",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "assets:optimize": "node scripts/optimize-delivery-assets.mjs",
    "audit:core-supply": "node scripts/audit-core-supply.mjs",
    "audit:stage-difficulty": "node scripts/audit-stage-difficulty.mjs",
    "audit:learning-curve": "node scripts/audit-learning-curve.mjs",
    "audit:audio-runtime": "node scripts/audit-audio-runtime.mjs",
    "audit:visual-states": "node scripts/audit-visual-states.mjs",
    "audit:weapon-situations": "node scripts/audit-weapon-situations.mjs",
    "build": "node scripts/build-static.mjs",
    "audit:static": "node scripts/audit-static.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "test": "node --test tests/**/*.test.mjs",
    "verify": "npm test && npm run build && npm run audit:static"
  }
}
