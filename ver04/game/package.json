{
  "name": "palimpsest-wake-v4-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "autoplay": "vitest run scripts/stage-01.report.test.ts scripts/stage-01-boss.report.test.ts",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run autoplay && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  }
}
