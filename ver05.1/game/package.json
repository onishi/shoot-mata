{
  "name": "chorus-shift-v5-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:e2e": "playwright test --workers=1",
    "package:release": "node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:release": "playwright test --config playwright.release.config.ts --workers=1",
    "audit:release": "npm run package:release && npm run verify:release && npm run test:release",
    "build": "npm run typecheck && vite build",
    "verify": "npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  }
}
